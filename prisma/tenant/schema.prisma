generator client {
  provider = "prisma-client"
  output   = "../../generated/tenant"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                         Int                             @id @default(autoincrement())
  name                       String
  slug                       String                          @unique
  sku                        String                          @unique
  barcode                    String?
  gtin                       String?
  gtinTributary              String?                         @map("gtin_tributary")
  mpn                        String?
  model                      String?
  type                       String                          @default("product")
  catalogType                String                          @default("simple") @map("catalog_type")
  status                     String                          @default("publish")
  catalogVisibility          String                          @default("visible") @map("catalog_visibility")
  featured                   Boolean                         @default(false)
  active                     Boolean                         @default(true)
  posRevision                Int                             @default(1) @map("pos_revision")
  posConfigHash              String                          @default(dbgenerated()) @map("pos_config_hash")
  description                String?
  shortDescription           String?                         @map("short_description")
  menuOrder                  Int                             @default(0) @map("menu_order")
  price                      Float                           @default(0)
  regularPrice               Float                           @default(0) @map("regular_price")
  salePrice                  Float?                          @map("sale_price")
  saleStartsAt               DateTime?                       @map("sale_starts_at")
  saleEndsAt                 DateTime?                       @map("sale_ends_at")
  installmentPrice           Float?                          @map("installment_price")
  cashPrice                  Float?                          @map("cash_price")
  minimumSalePrice           Float?                          @map("minimum_sale_price")
  targetMargin               Float?                          @map("target_margin")
  pricingSource              String                          @default("auto") @map("pricing_source")
  cost                       Float                           @default(0)
  cogs                       Float?                          @map("cogs_value")
  category                   String
  categoryId                 Int?                            @map("category_id")
  brandId                    Int?                            @map("brand_id")
  supplier                   String?
  stock                      Float                           @default(0)
  manageStock                Boolean                         @default(true) @map("manage_stock")
  stockStatus                String                          @default("instock") @map("stock_status")
  backorders                 String                          @default("no")
  minStock                   Float                           @default(0) @map("min_stock")
  soldIndividually           Boolean                         @default(false) @map("sold_individually")
  totalSales                 Float                           @default(0) @map("total_sales")
  unit                       String                          @default("UN")
  weight                     Float?
  weightUnit                 String                          @default("kg") @map("weight_unit")
  length                     Float?
  width                      Float?
  height                     Float?
  dimensionUnit              String                          @default("cm") @map("dimension_unit")
  netWeight                  Float?                          @map("net_weight")
  grossWeight                Float?                          @map("gross_weight")
  volumes                    Int?
  itemsPerBox                Float?                          @map("items_per_box")
  shippingClass              String?                         @map("shipping_class")
  crossDockingDays           Int?                            @map("cross_docking_days")
  freeShipping               Boolean                         @default(false) @map("free_shipping")
  virtual                    Boolean                         @default(false)
  taxStatus                  String                          @default("taxable") @map("tax_status")
  taxClass                   String?                         @map("tax_class")
  downloadable               Boolean                         @default(false)
  downloadLimit              Int?                            @map("download_limit")
  downloadExpiryDays         Int?                            @map("download_expiry_days")
  externalUrl                String?                         @map("external_url")
  buttonText                 String?                         @map("button_text")
  reviewsAllowed             Boolean                         @default(true) @map("reviews_allowed")
  averageRating              Float                           @default(0) @map("average_rating")
  ratingCount                Int                             @default(0) @map("rating_count")
  likesCount                 Int                             @default(0) @map("likes_count")
  purchaseNote               String?                         @map("purchase_note")
  warrantyMonths             Float?                          @map("warranty_months")
  condition                  String                          @default("new")
  fiscalType                 String                          @default("product") @map("fiscal_type")
  production                 String?
  expiry                     String?
  expiryDate                 DateTime?                       @map("expiry_date") @db.Date
  ncm                        String?
  cest                       String?
  cestNotApplicable          Boolean                         @default(false) @map("cest_not_applicable")
  origin                     String?
  spedItemType               String?                         @map("sped_item_type")
  taxBurdenRate              Float?                          @map("tax_burden_rate")
  additionalInvoiceInfo      String?                         @map("additional_invoice_info")
  icmsStBase                 Float?                          @map("icms_st_base")
  icmsStValue                Float?                          @map("icms_st_value")
  icmsSubstituteValue        Float?                          @map("icms_substitute_value")
  ipiExceptionCode           String?                         @map("ipi_exception_code")
  ipiClassification          String?                         @map("ipi_classification")
  pisFixedValue              Float?                          @map("pis_fixed_value")
  cofinsFixedValue           Float?                          @map("cofins_fixed_value")
  csosn                      String?
  fci                        String?
  anatelCode                 String?                         @map("anatel_code")
  anvisaCode                 String?                         @map("anvisa_code")
  inmetroCode                String?                         @map("inmetro_code")
  mapaCode                   String?                         @map("mapa_code")
  gender                     String?
  seoTitle                   String?                         @map("seo_title")
  seoDescription             String?                         @map("seo_description")
  seoNoindex                 Boolean                         @default(false) @map("seo_noindex")
  seoCanonical               String?                         @map("seo_canonical")
  seoFocusKeyword            String?                         @map("seo_focus_keyword")
  seoSecondaryKeywords       String[]                        @default([]) @map("seo_secondary_keywords")
  seoScore                   Int?                            @map("seo_score")
  seoSchemaType              String                          @default("Product") @map("seo_schema_type")
  seoOgImageMediaId          String?                         @map("seo_og_image_media_id")
  imageMediaId               String?                         @map("image_media_id")
  videoType                  String?                         @map("video_type")
  videoUrl                   String?                         @map("video_url")
  videoMediaId               String?                         @map("video_media_id")
  videoThumbnailMediaId      String?                         @map("video_thumbnail_media_id")
  videoAspectRatio           String?                         @map("video_aspect_ratio")
  defaultVariationRule       String                          @default("lowest_price") @map("default_variation_rule")
  badges                     Json?
  carouselConfig             Json?                           @map("carousel_config")
  configuratorData           Json?                           @map("configurator_data")
  customFields               Json?                           @map("custom_fields")
  onboardingStatus           String                          @default("complete") @map("onboarding_status")
  onboardingSource           String?                         @map("onboarding_source")
  onboardingMissingFields    String[]                        @default([]) @map("onboarding_missing_fields")
  lastPurchaseAt             DateTime?                       @map("last_purchase_at")
  createdAt                  DateTime                        @default(now()) @map("created_at")
  updatedAt                  DateTime                        @updatedAt @map("updated_at")
  movements                  StockMovement[]
  saleItems                  SaleItem[]
  posReturnItems             PosReturnItem[]
  heldSaleItems              PosHeldSaleItem[]
  categoryRecord             Category?                       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand                      ProductBrand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplierLinks              SupplierProduct[]
  purchaseQuotationItems     PurchaseQuotationItem[]
  purchaseItems              PurchaseOrderItem[]
  receiptItems               GoodsReceiptItem[]
  warehouseBalances          WarehouseBalance[]
  warehouseVariationBalances WarehouseVariationBalance[]
  inventoryCountItems        InventoryCountItem[]
  stockTransferItems         StockTransferItem[]
  warehouseLedgerEntries     WarehouseLedgerEntry[]
  salesOrderItems            SalesOrderItem[]
  serviceOrderItems          ServiceOrderItem[]
  purchaseInvoiceItems       PurchaseInvoiceItem[]
  bomOutputs                 BillOfMaterial[]                @relation("BomOutput")
  bomMaterials               BillOfMaterialItem[]            @relation("BomMaterial")
  productionOutputs          ProductionOrder[]               @relation("ProductionOutput")
  marketplaceListings        MarketplaceListing[]
  reviews                    ProductReview[]
  imageMedia                 TenantMediaAsset?               @relation("ProductPrimaryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  seoOgImageMedia            TenantMediaAsset?               @relation("ProductSeoImage", fields: [seoOgImageMediaId], references: [id], onDelete: SetNull)
  videoMedia                 TenantMediaAsset?               @relation("ProductVideo", fields: [videoMediaId], references: [id], onDelete: SetNull)
  videoThumbnailMedia        TenantMediaAsset?               @relation("ProductVideoThumbnail", fields: [videoThumbnailMediaId], references: [id], onDelete: SetNull)
  branchConfigurations       BranchProduct[]
  stockReservations          StockReservation[]
  gallery                    ProductImage[]
  categoryLinks              ProductCategoryLink[]
  tagLinks                   ProductTagLink[]
  attributes                 ProductAttribute[]
  variations                 ProductVariation[]
  downloads                  ProductDownload[]
  costItems                  ProductCostItem[]
  priceTiers                 ProductPriceTier[]
  marketplaceProfiles        ProductMarketplaceProfile[]
  relatedFrom                ProductRelation[]               @relation("ProductRelationSource")
  relatedTo                  ProductRelation[]               @relation("ProductRelationTarget")
  slugRedirects              ProductSlugRedirect[]
  posCodes                   PosProductCode[]
  posInventoryLots           PosInventoryLot[]
  productionReservations     ProductionMaterialReservation[]
  productionProcurements     ProductionProcurement[]
  posKitBoms                 PosKitBom[]                     @relation("PosKitProduct")
  posKitBomComponents        PosKitBomComponent[]            @relation("PosKitComponentProduct")
  posKitSaleComponents       PosKitSaleComponent[]           @relation("PosKitSaleComponentProduct")

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@index([status, catalogVisibility])
  @@index([gtin])
  @@index([imageMediaId])
  @@map("products")
}

model ProductBrand {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  slug        String            @unique
  description String?
  logoMediaId String?           @map("logo_media_id")
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  products    Product[]
  logoMedia   TenantMediaAsset? @relation("ProductBrandLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)

  @@index([active, name])
  @@map("product_brands")
}

model ProductSlugRedirect {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  oldSlug   String   @unique @map("old_slug")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_slug_redirects")
}

model ProductImage {
  id           Int              @id @default(autoincrement())
  productId    Int              @map("product_id")
  mediaAssetId String           @map("media_asset_id")
  position     Int              @default(0)
  altText      String?          @map("alt_text")
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   TenantMediaAsset @relation("ProductGallery", fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaAssetId])
  @@index([productId, position])
  @@map("product_images")
}

model ProductCategoryLink {
  productId  Int      @map("product_id")
  categoryId Int      @map("category_id")
  primary    Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_category_links")
}

model ProductTag {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  slug      String           @unique
  createdAt DateTime         @default(now()) @map("created_at")
  products  ProductTagLink[]

  @@map("product_tags")
}

model ProductTagLink {
  productId Int        @map("product_id")
  tagId     Int        @map("tag_id")
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tag_links")
}

model ProductAttribute {
  id         Int                      @id @default(autoincrement())
  productId  Int                      @map("product_id")
  name       String
  slug       String
  type       String                   @default("select")
  swatchType String                   @default("select") @map("swatch_type")
  scope      String                   @default("local")
  visible    Boolean                  @default(true)
  variation  Boolean                  @default(false)
  position   Int                      @default(0)
  product    Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    ProductAttributeOption[]

  @@unique([productId, slug])
  @@index([productId, position])
  @@map("product_attributes")
}

model ProductAttributeOption {
  id           Int               @id @default(autoincrement())
  attributeId  Int               @map("attribute_id")
  name         String
  value        String
  color        String?
  imageMediaId String?           @map("image_media_id")
  position     Int               @default(0)
  attribute    ProductAttribute  @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  imageMedia   TenantMediaAsset? @relation("ProductAttributeOptionImage", fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@unique([attributeId, value])
  @@index([attributeId, position])
  @@map("product_attribute_options")
}

model ProductVariation {
  id                     Int                             @id @default(autoincrement())
  productId              Int                             @map("product_id")
  sku                    String?                         @unique
  gtin                   String?
  status                 String                          @default("publish")
  attributes             Json
  regularPrice           Float?                          @map("regular_price")
  salePrice              Float?                          @map("sale_price")
  saleStartsAt           DateTime?                       @map("sale_starts_at")
  saleEndsAt             DateTime?                       @map("sale_ends_at")
  manageStock            String                          @default("parent") @map("manage_stock")
  stock                  Float?
  stockStatus            String?                         @map("stock_status")
  backorders             String?
  weight                 Float?
  length                 Float?
  width                  Float?
  height                 Float?
  imageMediaId           String?                         @map("image_media_id")
  videoUrl               String?                         @map("video_url")
  description            String?
  enabled                Boolean                         @default(true)
  posRevision            Int                             @default(1) @map("pos_revision")
  posConfigHash          String                          @default(dbgenerated()) @map("pos_config_hash")
  menuOrder              Int                             @default(0) @map("menu_order")
  createdAt              DateTime                        @default(now()) @map("created_at")
  updatedAt              DateTime                        @updatedAt @map("updated_at")
  product                Product                         @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageMedia             TenantMediaAsset?               @relation("ProductVariationImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  gallery                ProductVariationImage[]
  salesOrderItems        SalesOrderItem[]
  posCodes               PosProductCode[]
  saleItems              SaleItem[]
  heldSaleItems          PosHeldSaleItem[]
  posInventoryLots       PosInventoryLot[]
  purchaseOrderItems     PurchaseOrderItem[]
  goodsReceiptItems      GoodsReceiptItem[]
  productionProcurements ProductionProcurement[]
  productionReservations ProductionMaterialReservation[]
  warehouseBalances      WarehouseVariationBalance[]
  stockReservations      StockReservation[]
  stockMovements         StockMovement[]
  warehouseLedgerEntries WarehouseLedgerEntry[]
  posKitBoms             PosKitBom[]                     @relation("PosKitVariation")
  posKitBomComponents    PosKitBomComponent[]            @relation("PosKitComponentVariation")
  posKitSaleComponents   PosKitSaleComponent[]           @relation("PosKitSaleComponentVariation")

  @@unique([id, productId])
  @@index([productId, menuOrder])
  @@index([gtin])
  @@map("product_variations")
}

model ProductVariationImage {
  id           Int              @id @default(autoincrement())
  variationId  Int              @map("variation_id")
  mediaAssetId String           @map("media_asset_id")
  position     Int              @default(0)
  variation    ProductVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  mediaAsset   TenantMediaAsset @relation("ProductVariationGallery", fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([variationId, mediaAssetId])
  @@index([variationId, position])
  @@map("product_variation_images")
}

model ProductDownload {
  id           Int               @id @default(autoincrement())
  productId    Int               @map("product_id")
  name         String
  url          String?
  mediaAssetId String?           @map("media_asset_id")
  position     Int               @default(0)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   TenantMediaAsset? @relation("ProductDownloadMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@map("product_downloads")
}

model ProductCostItem {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  type      String   @default("direct")
  label     String
  value     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type])
  @@map("product_cost_items")
}

model ProductPriceTier {
  id         Int     @id @default(autoincrement())
  productId  Int     @map("product_id")
  minimumQty Float   @map("minimum_qty")
  maximumQty Float?  @map("maximum_qty")
  price      Float
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, minimumQty])
  @@map("product_price_tiers")
}

model ProductRelation {
  productId        Int     @map("product_id")
  relatedProductId Int     @map("related_product_id")
  type             String
  position         Int     @default(0)
  product          Product @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product @relation("ProductRelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId, type])
  @@index([relatedProductId, type])
  @@map("product_relations")
}

model ProductMarketplaceProfile {
  id                     Int                 @id @default(autoincrement())
  productId              Int                 @map("product_id")
  channelId              Int?                @map("channel_id")
  platform               String
  remoteCategoryId       String?             @map("remote_category_id")
  remoteCatalogProductId String?             @map("remote_catalog_product_id")
  listingType            String?             @map("listing_type")
  attributes             Json?
  saleTerms              Json?               @map("sale_terms")
  priceOverride          Float?              @map("price_override")
  stockOverride          Float?              @map("stock_override")
  readiness              Int                 @default(0)
  ready                  Boolean             @default(false)
  missingFields          String[]            @default([]) @map("missing_fields")
  warnings               String[]            @default([])
  contentHash            String?             @map("content_hash")
  driftDetectedAt        DateTime?           @map("drift_detected_at")
  lastValidatedAt        DateTime?           @map("last_validated_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  product                Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  channel                MarketplaceChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([productId, channelId, platform])
  @@index([platform, ready])
  @@map("product_marketplace_profiles")
}

model StockMovement {
  id                     Int               @id @default(autoincrement())
  productId              Int               @map("product_id")
  type                   String
  quantity               Float
  previousStock          Float             @map("previous_stock")
  currentStock           Float             @map("current_stock")
  note                   String?
  userName               String            @map("user_name")
  warehouseId            Int?              @map("warehouse_id")
  variationId            Int?              @map("variation_id")
  variationPreviousStock Float?            @map("variation_previous_stock")
  variationCurrentStock  Float?            @map("variation_current_stock")
  createdAt              DateTime          @default(now()) @map("created_at")
  product                Product           @relation(fields: [productId], references: [id])
  warehouse              Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  variation              ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([warehouseId, createdAt])
  @@index([variationId, warehouseId, createdAt])
  @@map("stock_movements")
}

model Sale {
  id                                Int                           @id @default(autoincrement())
  saleNumber                        String                        @unique @map("sale_number")
  customer                          String
  seller                            String
  cashRegister                      String                        @map("cash_register")
  paymentMethod                     String                        @map("payment_method")
  total                             Float
  branchId                          Int?                          @map("branch_id")
  costCenterId                      Int?                          @map("cost_center_id")
  warehouseId                       Int?                          @map("warehouse_id")
  sessionId                         Int?                          @map("session_id")
  customerId                        Int?                          @map("customer_id")
  operatorProfileId                 Int?                          @map("operator_profile_id")
  status                            String                        @default("completed")
  subtotalCents                     Int                           @map("subtotal_cents")
  discountCents                     Int                           @map("discount_cents")
  surchargeCents                    Int                           @map("surcharge_cents")
  totalCents                        Int                           @map("total_cents")
  changeCents                       Int                           @map("change_cents")
  idempotencyKey                    String?                       @unique @map("idempotency_key")
  requestHash                       String?                       @map("request_hash")
  sourceType                        String?                       @map("source_type")
  sourceId                          String?                       @map("source_id")
  sourceCreationTxid                Decimal?                      @map("source_creation_txid") @db.Decimal(20, 0)
  fulfillmentMode                   String                        @default("on_site") @map("fulfillment_mode")
  manualPaymentApplicationId        String?                       @unique @map("manual_payment_application_id") @db.Uuid
  notes                             String?
  cancelledReason                   String?                       @map("cancelled_reason")
  cancelledBy                       String?                       @map("cancelled_by")
  cancelledAt                       DateTime?                     @map("cancelled_at")
  createdAt                         DateTime                      @default(now()) @map("created_at")
  updatedAt                         DateTime                      @default(now()) @updatedAt @map("updated_at")
  items                             SaleItem[]
  payments                          PosSalePayment[]
  events                            PosSaleEvent[]
  returns                           PosReturn[]
  exchangeOrigin                    PosReturn?                    @relation("PosReturnExchangeSale")
  promotionUses                     PosPromotionRedemption[]
  fiscalDocuments                   PosFiscalDocument[]
  paymentCompensations              PosPaymentCompensation[]
  orderClaims                       PosOrderClaim[]
  paymentPlan                       PosPaymentPlan?
  paymentPlanOperations             PosPaymentPlanOperation[]
  branch                            Branch?                       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  costCenter                        CostCenter?                   @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  warehouse                         Warehouse?                    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  session                           CashRegisterSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  customerRecord                    Customer?                     @relation("PosSaleCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  operatorProfile                   TenantUserProfile?            @relation("PosSaleOperator", fields: [operatorProfileId], references: [id], onDelete: SetNull)
  manualPaymentApplication          PosManualPaymentApplication?  @relation("PosManualT2CreatedSale", fields: [manualPaymentApplicationId], references: [id], onDelete: Restrict)
  manualPaymentApplicationsBySaleId PosManualPaymentApplication[] @relation("PosManualT2AppliedSale")

  @@unique([sourceType, sourceId])
  @@index([createdAt])
  @@index([branchId, createdAt])
  @@index([costCenterId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([sessionId, createdAt])
  @@index([customerId, createdAt])
  @@index([operatorProfileId, createdAt])
  @@index([status, createdAt])
  @@map("sales")
}

model SaleItem {
  id               Int                       @id @default(autoincrement())
  saleId           Int                       @map("sale_id")
  productId        Int                       @map("product_id")
  productName      String                    @map("product_name")
  skuSnapshot      String?                   @map("sku_snapshot")
  gtinSnapshot     String?                   @map("gtin_snapshot")
  variationId      Int?                      @map("variation_id")
  unit             String                    @default("UN")
  quantity         Float
  unitPrice        Float                     @map("unit_price")
  total            Float
  unitPriceCents   Int                       @map("unit_price_cents")
  grossCents       Int                       @map("gross_cents")
  discountCents    Int                       @map("discount_cents")
  surchargeCents   Int                       @map("surcharge_cents")
  totalCents       Int                       @map("total_cents")
  scanData         Json?                     @map("scan_data")
  returnedQuantity Float                     @default(0) @map("returned_quantity")
  returnedCents    Int                       @default(0) @map("returned_cents")
  sale             Sale                      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product                   @relation(fields: [productId], references: [id])
  variation        ProductVariation?         @relation(fields: [variationId], references: [id], onDelete: SetNull)
  returnItems      PosReturnItem[]
  lotMovements     PosInventoryLotMovement[]
  kitComponents    PosKitSaleComponent[]

  @@index([saleId, productId])
  @@map("sale_items")
}

model PosRegister {
  id                      Int                         @id @default(autoincrement())
  branchId                Int                         @map("branch_id")
  warehouseId             Int?                        @map("warehouse_id")
  code                    String
  name                    String
  status                  String                      @default("active")
  settings                Json?
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  branch                  Branch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse               Warehouse?                  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  accesses                PosRegisterAccess[]
  terminals               PosTerminal[]
  sessions                CashRegisterSession[]
  connectors              PosConnector[]
  heldSales               PosHeldSale[]
  heldTransfersFrom       PosHeldSaleTransfer[]       @relation("PosHeldTransferFromRegister")
  heldTransfersTo         PosHeldSaleTransfer[]       @relation("PosHeldTransferToRegister")
  sessionHandoffs         PosSessionHandoff[]
  returns                 PosReturn[]
  manualPaymentReferences PosManualPaymentReference[]
  paymentIntents          PosPaymentIntent[]
  fiscalDocuments         PosFiscalDocument[]
  paymentCompensations    PosPaymentCompensation[]
  cashLedgerEntries       PosCashLedgerEntry[]
  cashCustodyBags         PosCashCustodyBag[]
  orderClaims             PosOrderClaim[]
  paymentPlans            PosPaymentPlan[]
  manualPaymentCases      PosManualPaymentCase[]

  @@unique([id, branchId], map: "pos_registers_id_branch_id_key")
  @@unique([branchId, code])
  @@index([branchId, status])
  @@map("pos_registers")
}

model PosProductCode {
  id              Int               @id @default(autoincrement())
  productId       Int               @map("product_id")
  variationId     Int?              @map("variation_id")
  branchId        Int?              @map("branch_id")
  scopeKey        String            @default("global") @map("scope_key")
  code            String
  normalizedCode  String            @map("normalized_code")
  symbology       String            @default("unknown")
  packageQuantity Float             @default(1) @map("package_quantity")
  unit            String?
  priority        Int               @default(0)
  active          Boolean           @default(true)
  version         Int               @default(0)
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation       ProductVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)
  branch          Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, normalizedCode])
  @@index([productId, active])
  @@index([variationId, active])
  @@index([branchId, active])
  @@map("pos_product_codes")
}

model PosVariableCodeRule {
  id                  String   @id @default(cuid())
  branchId            Int      @map("branch_id")
  name                String
  status              String   @default("active")
  prefix              String
  totalLength         Int      @map("total_length")
  productCodeStart    Int      @map("product_code_start")
  productCodeLength   Int      @map("product_code_length")
  lookupSymbology     String   @default("plu") @map("lookup_symbology")
  valueStart          Int      @map("value_start")
  valueLength         Int      @map("value_length")
  valueMode           String   @map("value_mode")
  valueScale          Int      @map("value_scale")
  measurementUnit     String   @map("measurement_unit")
  checkDigitAlgorithm String   @default("gtin") @map("check_digit_algorithm")
  priority            Int      @default(0)
  version             Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, name])
  @@index([branchId, status, priority])
  @@map("pos_variable_code_rules")
}

model PosInventoryLot {
  id                      String                          @id @default(cuid())
  warehouseId             Int                             @map("warehouse_id")
  productId               Int                             @map("product_id")
  variationId             Int?                            @map("variation_id")
  lotCode                 String?                         @map("lot_code")
  normalizedLotCode       String?                         @map("normalized_lot_code")
  serialNumber            String?                         @map("serial_number")
  normalizedSerialNumber  String?                         @map("normalized_serial_number")
  manufacturedOn          DateTime?                       @map("manufactured_on") @db.Date
  expiresOn               DateTime?                       @map("expires_on") @db.Date
  receivedAt              DateTime                        @default(now()) @map("received_at")
  bucketKey               String                          @default("sellable") @map("bucket_key")
  status                  String                          @default("available")
  quantityMicros          BigInt                          @map("quantity_micros")
  reservedMicros          BigInt                          @default(0) @map("reserved_micros")
  metadata                Json?
  createdAt               DateTime                        @default(now()) @map("created_at")
  updatedAt               DateTime                        @updatedAt @map("updated_at")
  warehouse               Warehouse                       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product                 Product                         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variation               ProductVariation?               @relation(fields: [variationId], references: [id], onDelete: Restrict)
  movements               PosInventoryLotMovement[]
  shipmentPickAllocations ShipmentPickAllocation[]
  productionReservations  ProductionMaterialReservation[]
  logisticsReturnItems    OrderReturnItem[]               @relation("LogisticsReturnLot")

  @@index([warehouseId, productId, variationId, status, expiresOn])
  @@index([warehouseId, productId, variationId, normalizedLotCode, bucketKey])
  @@index([productId, normalizedLotCode])
  @@index([status, expiresOn])
  @@map("pos_inventory_lots")
}

model PosInventoryLotMovement {
  id                  BigInt          @id @default(autoincrement())
  lotId               String          @map("lot_id")
  saleItemId          Int?            @map("sale_item_id")
  returnItemId        Int?            @map("return_item_id")
  type                String
  quantityMicros      BigInt          @map("quantity_micros")
  balanceBeforeMicros BigInt          @map("balance_before_micros")
  balanceAfterMicros  BigInt          @map("balance_after_micros")
  referenceType       String?         @map("reference_type")
  referenceId         String?         @map("reference_id")
  idempotencyKey      String?         @unique @map("idempotency_key")
  actor               String
  metadata            Json?
  occurredAt          DateTime        @default(now()) @map("occurred_at")
  lot                 PosInventoryLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  saleItem            SaleItem?       @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  returnItem          PosReturnItem?  @relation(fields: [returnItemId], references: [id], onDelete: Restrict)

  @@index([lotId, occurredAt])
  @@index([saleItemId, occurredAt])
  @@index([returnItemId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("pos_inventory_lot_movements")
}

model PosKitBom {
  id             String                @id @default(cuid())
  branchId       Int                   @map("branch_id")
  kitProductId   Int                   @map("kit_product_id")
  kitVariationId Int?                  @map("kit_variation_id")
  scopeKey       String                @map("scope_key")
  version        Int
  name           String
  status         String                @default("draft")
  effectiveFrom  DateTime?             @map("effective_from")
  createdBy      String                @map("created_by")
  activatedBy    String?               @map("activated_by")
  activatedAt    DateTime?             @map("activated_at")
  retiredBy      String?               @map("retired_by")
  retiredAt      DateTime?             @map("retired_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  branch         Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  kitProduct     Product               @relation("PosKitProduct", fields: [kitProductId], references: [id], onDelete: Restrict)
  kitVariation   ProductVariation?     @relation("PosKitVariation", fields: [kitVariationId], references: [id], onDelete: Restrict)
  components     PosKitBomComponent[]
  saleComponents PosKitSaleComponent[]

  @@unique([branchId, scopeKey, version])
  @@unique([id, version], map: "pos_kit_boms_id_version_key")
  @@index([branchId, status, effectiveFrom])
  @@index([kitProductId, kitVariationId, status])
  @@map("pos_kit_boms")
}

model PosKitBomComponent {
  id                String            @id @default(cuid())
  bomId             String            @map("bom_id")
  productId         Int               @map("product_id")
  variationId       Int?              @map("variation_id")
  componentScopeKey String            @map("component_scope_key")
  quantityMicros    BigInt            @map("quantity_micros")
  position          Int               @default(0)
  createdAt         DateTime          @default(now()) @map("created_at")
  bom               PosKitBom         @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product           Product           @relation("PosKitComponentProduct", fields: [productId], references: [id], onDelete: Restrict)
  variation         ProductVariation? @relation("PosKitComponentVariation", fields: [variationId], references: [id], onDelete: Restrict)

  @@unique([bomId, componentScopeKey])
  @@index([productId, variationId])
  @@map("pos_kit_bom_components")
}

model PosKitSaleComponent {
  id                 String                          @id @default(cuid())
  saleItemId         Int                             @map("sale_item_id")
  bomId              String                          @map("bom_id")
  bomVersion         Int                             @map("bom_version")
  productId          Int                             @map("product_id")
  variationId        Int?                            @map("variation_id")
  componentScopeKey  String                          @map("component_scope_key")
  unitQuantityMicros BigInt                          @map("unit_quantity_micros")
  quantityMicros     BigInt                          @map("quantity_micros")
  returnedMicros     BigInt                          @default(0) @map("returned_micros")
  snapshot           Json
  createdAt          DateTime                        @default(now()) @map("created_at")
  updatedAt          DateTime                        @updatedAt @map("updated_at")
  saleItem           SaleItem                        @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  bom                PosKitBom                       @relation(fields: [bomId, bomVersion], references: [id, version], onDelete: Restrict)
  product            Product                         @relation("PosKitSaleComponentProduct", fields: [productId], references: [id], onDelete: Restrict)
  variation          ProductVariation?               @relation("PosKitSaleComponentVariation", fields: [variationId], references: [id], onDelete: Restrict)
  returnMovements    PosKitComponentReturnMovement[]

  @@unique([saleItemId, componentScopeKey])
  @@index([saleItemId, returnedMicros])
  @@index([productId, variationId])
  @@map("pos_kit_sale_components")
}

model PosKitComponentReturnMovement {
  id              BigInt              @id @default(autoincrement())
  saleComponentId String              @map("sale_component_id")
  returnItemId    Int?                @map("return_item_id")
  quantityMicros  BigInt              @map("quantity_micros")
  disposition     String
  referenceType   String              @map("reference_type")
  referenceId     String              @map("reference_id")
  operationKey    String              @unique @map("operation_key")
  actor           String
  createdAt       DateTime            @default(now()) @map("created_at")
  saleComponent   PosKitSaleComponent @relation(fields: [saleComponentId], references: [id], onDelete: Restrict)
  returnItem      PosReturnItem?      @relation(fields: [returnItemId], references: [id], onDelete: Restrict)

  @@index([saleComponentId, createdAt])
  @@index([referenceType, referenceId])
  @@map("pos_kit_component_return_movements")
}

model PosRegisterAccess {
  id                            Int               @id @default(autoincrement())
  registerId                    Int               @map("register_id")
  userProfileId                 Int               @map("user_profile_id")
  active                        Boolean           @default(true)
  canOpen                       Boolean           @default(true) @map("can_open")
  canClose                      Boolean           @default(true) @map("can_close")
  canSell                       Boolean           @default(true) @map("can_sell")
  canSupply                     Boolean           @default(false) @map("can_supply")
  canWithdraw                   Boolean           @default(false) @map("can_withdraw")
  canCancel                     Boolean           @default(false) @map("can_cancel")
  canRefund                     Boolean           @default(false) @map("can_refund")
  canReprint                    Boolean           @default(true) @map("can_reprint")
  canManualPayment              Boolean           @default(false) @map("can_manual_payment")
  canReviewManualPayment        Boolean           @default(false) @map("can_review_manual_payment")
  manualPaymentReviewLimitCents Int               @default(0) @map("manual_payment_review_limit_cents")
  canTransferHeld               Boolean           @default(false) @map("can_transfer_held")
  maxDiscountBasisPoints        Int               @default(0) @map("max_discount_basis_points")
  validFrom                     DateTime?         @map("valid_from")
  validUntil                    DateTime?         @map("valid_until")
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")
  register                      PosRegister       @relation(fields: [registerId], references: [id], onDelete: Cascade)
  userProfile                   TenantUserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([registerId, userProfileId])
  @@index([userProfileId, active])
  @@map("pos_register_accesses")
}

model PosTerminal {
  id                     String                   @id @default(cuid())
  registerId             Int                      @map("register_id")
  code                   String
  name                   String
  status                 String                   @default("unpaired")
  tokenHash              String?                  @map("token_hash")
  tokenIssuedAt          DateTime?                @map("token_issued_at")
  tokenExpiresAt         DateTime?                @map("token_expires_at")
  credentialVersion      Int                      @default(0) @map("credential_version")
  certificateFingerprint String?                  @map("certificate_fingerprint")
  appVersion             String?                  @map("app_version")
  settings               Json?
  lastSeenAt             DateTime?                @map("last_seen_at")
  lastSyncCursor         BigInt                   @default(0) @map("last_sync_cursor")
  lastSyncAckCursor      BigInt                   @default(0) @map("last_sync_ack_cursor")
  offlineAllowedUntil    DateTime?                @map("offline_allowed_until")
  pairedAt               DateTime?                @map("paired_at")
  revokedAt              DateTime?                @map("revoked_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  register               PosRegister              @relation(fields: [registerId], references: [id], onDelete: Cascade)
  devices                PosDevice[]
  syncOperations         PosSyncOperation[]
  offlineCredentials     PosOfflineCredential[]
  offlineDrafts          PosOfflineDraft[]
  printJobs              PosPrintJob[]
  pairingCodes           PdvTerminalPairing[]
  paymentIntents         PosPaymentIntent[]
  fiscalDocuments        PosFiscalDocument[]
  paymentCompensations   PosPaymentCompensation[]
  cashLedgerEntries      PosCashLedgerEntry[]
  cashCustodyBags        PosCashCustodyBag[]
  orderClaims            PosOrderClaim[]
  paymentPlans           PosPaymentPlan[]
  manualPaymentCases     PosManualPaymentCase[]
  cashSessions           CashRegisterSession[]

  @@unique([registerId, code])
  @@unique([id, registerId], map: "pos_terminals_id_register_id_key")
  @@index([status, lastSeenAt])
  @@map("pos_terminals")
}

model PosDevice {
  id           String      @id @default(cuid())
  terminalId   String      @map("terminal_id")
  type         String
  name         String
  provider     String?
  vendorId     String?     @map("vendor_id")
  productId    String?     @map("product_id")
  serialNumber String?     @map("serial_number")
  status       String      @default("unknown")
  capabilities Json?
  settings     Json?
  lastError    String?     @map("last_error")
  lastSeenAt   DateTime?   @map("last_seen_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  terminal     PosTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@unique([terminalId, type, name])
  @@index([terminalId, status])
  @@map("pos_devices")
}

model PosConnector {
  id                       String                              @id @default(cuid())
  branchId                 Int                                 @map("branch_id")
  registerId               Int?                                @map("register_id")
  type                     String
  provider                 String
  mode                     String                              @default("server")
  status                   String                              @default("inactive")
  revision                 Int                                 @default(0)
  credentialRef            String?                             @map("credential_ref")
  settings                 Json?
  lastHealthOk             Boolean?                            @map("last_health_ok")
  lastCheckedAt            DateTime?                           @map("last_checked_at")
  createdAt                DateTime                            @default(now()) @map("created_at")
  updatedAt                DateTime                            @updatedAt @map("updated_at")
  branch                   Branch                              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  register                 PosRegister?                        @relation(fields: [registerId], references: [id], onDelete: Cascade)
  payments                 PosSalePayment[]
  paymentIntents           PosPaymentIntent[]
  fiscalProfiles           PosFiscalProfileVersion[]
  fiscalDocuments          PosFiscalDocument[]
  paymentCompensations     PosPaymentCompensation[]
  paymentPlanSlots         PosPaymentPlanSlot[]
  manualPaymentCases       PosManualPaymentCase[]
  manualReconciliationGate PosManualPaymentReconciliationGate?

  @@unique([id, branchId, provider], map: "pos_connectors_id_branch_id_provider_key")
  @@unique([branchId, registerId, type, provider])
  @@index([branchId, type, status])
  @@map("pos_connectors")
}

model PdvAdminMutation {
  id             BigInt   @id @default(autoincrement())
  key            String   @unique
  actorId        String   @map("actor_id")
  action         String
  requestHash    String   @map("request_hash")
  state          String   @default("processing")
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([state, expiresAt])
  @@map("pos_admin_mutations")
}

model PdvTerminalPairing {
  id             String      @id @default(cuid())
  terminalId     String      @map("terminal_id")
  codeHash       String      @unique @map("code_hash")
  codeLastFour   String      @map("code_last_four")
  state          String      @default("pending")
  attempts       Int         @default(0)
  maxAttempts    Int         @default(5) @map("max_attempts")
  idempotencyKey String      @unique @map("idempotency_key")
  requestHash    String      @map("request_hash")
  correlationId  String      @map("correlation_id")
  createdBy      String      @map("created_by")
  expiresAt      DateTime    @map("expires_at")
  consumedAt     DateTime?   @map("consumed_at")
  revokedAt      DateTime?   @map("revoked_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  terminal       PosTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([terminalId, state, expiresAt])
  @@index([state, expiresAt])
  @@map("pos_terminal_pairings")
}

model PosSalePayment {
  id                       String                       @id @default(cuid())
  saleId                   Int                          @map("sale_id")
  connectorId              String?                      @map("connector_id")
  originalPaymentId        String?                      @map("original_payment_id")
  processingSessionId      Int?                         @map("processing_session_id")
  type                     String                       @default("payment")
  method                   String
  status                   String                       @default("captured")
  amountCents              Int                          @map("amount_cents")
  tenderedCents            Int                          @default(0) @map("tendered_cents")
  changeCents              Int                          @default(0) @map("change_cents")
  provider                 String?
  transactionId            String?                      @map("transaction_id")
  endToEndId               String?                      @map("end_to_end_id")
  nsu                      String?
  authorizationCode        String?                      @map("authorization_code")
  cardBrand                String?                      @map("card_brand")
  cardLastFour             String?                      @map("card_last_four")
  installments             Int                          @default(1)
  idempotencyKey           String                       @unique @map("idempotency_key")
  paymentIntentId          String?                      @unique @map("payment_intent_id")
  compensationId           String?                      @unique @map("compensation_id")
  paymentPlanId            String?                      @map("payment_plan_id")
  paymentIndex             Int?                         @map("payment_index")
  valueReservationId       String?                      @unique @map("value_reservation_id")
  valueCaptureEntryId      BigInt?                      @unique @map("value_capture_entry_id")
  valueAmountUnits         BigInt?                      @map("value_amount_units")
  manualPaymentCaseId      String?                      @unique @map("manual_payment_case_id") @db.Uuid
  metadata                 Json?
  authorizedAt             DateTime?                    @map("authorized_at")
  capturedAt               DateTime?                    @map("captured_at")
  refundedAt               DateTime?                    @map("refunded_at")
  createdAt                DateTime                     @default(now()) @map("created_at")
  updatedAt                DateTime                     @updatedAt @map("updated_at")
  sale                     Sale                         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  connector                PosConnector?                @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  originalPayment          PosSalePayment?              @relation("PosPaymentRefunds", fields: [originalPaymentId], references: [id], onDelete: SetNull)
  refunds                  PosSalePayment[]             @relation("PosPaymentRefunds")
  processingSession        CashRegisterSession?         @relation("PosPaymentProcessingSession", fields: [processingSessionId], references: [id], onDelete: SetNull)
  reconciliationIssues     PosReconciliationIssue[]
  manualReference          PosManualPaymentReference?
  paymentIntent            PosPaymentIntent?            @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  compensation             PosPaymentCompensation?      @relation("PosCompensationAppliedRefund", fields: [compensationId], references: [id], onDelete: Restrict)
  compensationRequests     PosPaymentCompensation[]     @relation("PosCompensationOriginalPayment")
  paymentPlanSlot          PosPaymentPlanSlot?          @relation(fields: [paymentPlanId, paymentIndex], references: [planId, paymentIndex], onDelete: Restrict)
  valueReservation         PosValueReservation?         @relation(fields: [valueReservationId], references: [id], onDelete: Restrict)
  valueCaptureEntry        PosValueLedgerEntry?         @relation(fields: [valueCaptureEntryId], references: [id], onDelete: Restrict)
  manualReconciliationCase PosManualPaymentCase?        @relation("PosManualCaseAppliedPayment")
  manualPaymentCase        PosManualPaymentCase?        @relation("PosManualT2SalePaymentCase", fields: [manualPaymentCaseId], references: [id], onDelete: Restrict)
  manualPaymentApplication PosManualPaymentApplication? @relation("PosManualT2ApplicationSalePayment")

  @@unique([paymentPlanId, paymentIndex], map: "pos_sale_payments_payment_plan_slot_key")
  @@index([saleId, status])
  @@index([processingSessionId, status])
  @@index([provider, transactionId])
  @@index([endToEndId])
  @@map("pos_sale_payments")
}

model PosPaymentIntent {
  id                 String                        @id
  branchId           Int                           @map("branch_id")
  registerId         Int                           @map("register_id")
  sessionId          Int                           @map("session_id")
  operatorProfileId  Int                           @map("operator_profile_id")
  terminalId         String?                       @map("terminal_id")
  connectorId        String                        @map("connector_id")
  credentialRef      String                        @map("credential_ref")
  saleDraftId        String                        @map("sale_draft_id")
  paymentPlanId      String?                       @map("payment_plan_id")
  paymentIndex       Int                           @map("payment_index")
  status             String                        @default("created")
  version            Int                           @default(0)
  amountCents        Int                           @map("amount_cents")
  currency           String                        @default("BRL")
  method             String
  installments       Int                           @default(1)
  provider           String
  providerReference  String?                       @map("provider_reference")
  transactionId      String?                       @map("transaction_id")
  endToEndId         String?                       @map("end_to_end_id")
  nsu                String?
  authorizationCode  String?                       @map("authorization_code")
  cardBrand          String?                       @map("card_brand")
  cardLastFour       String?                       @map("card_last_four")
  evidenceId         String?                       @map("evidence_id")
  failureCode        String?                       @map("failure_code")
  failureMessage     String?                       @map("failure_message")
  providerSequence   BigInt?                       @map("provider_sequence")
  providerOccurredAt DateTime?                     @map("provider_occurred_at")
  unknownSince       DateTime?                     @map("unknown_since")
  nextReconcileAt    DateTime?                     @map("next_reconcile_at")
  expiresAt          DateTime                      @map("expires_at")
  idempotencyKey     String                        @unique @map("idempotency_key")
  requestHash        String                        @map("request_hash")
  consumedAt         DateTime?                     @map("consumed_at")
  lifecycleTxid      Decimal                       @default(dbgenerated("(txid_current())::numeric")) @map("lifecycle_txid") @db.Decimal(20, 0)
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")
  branch             Branch                        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  register           PosRegister                   @relation(fields: [registerId], references: [id], onDelete: Restrict)
  session            CashRegisterSession           @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  operatorProfile    TenantUserProfile             @relation(fields: [operatorProfileId], references: [id], onDelete: Restrict)
  terminal           PosTerminal?                  @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  connector          PosConnector                  @relation(fields: [connectorId], references: [id], onDelete: Restrict)
