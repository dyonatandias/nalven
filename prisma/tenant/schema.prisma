  version               Int                      @default(1)
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  contacts              SupplierContact[]
  addresses             SupplierAddress[]
  tagLinks              SupplierTagLink[]
  interactions          SupplierInteraction[]
  complianceDocuments   SupplierDocument[]
  evaluations           SupplierEvaluation[]
  products              SupplierProduct[]
  purchaseOrders        PurchaseOrder[]
  quotationOffers       PurchaseQuotationOffer[]
  financialTitles       FinancialTitle[]
  purchaseInvoices      PurchaseInvoice[]

  @@index([name])
  @@index([status])
  @@index([category, status])
  @@index([homologationStatus, status])
  @@index([riskRating, status])
  @@index([createdAt])
  @@map("suppliers")
}

model SupplierContact {
  id         Int       @id @default(autoincrement())
  supplierId Int       @map("supplier_id")
  name       String
  role       String?
  email      String?
  phone      String?
  primary    Boolean   @default(false)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, archivedAt, primary])
  @@map("supplier_contacts")
}

model SupplierAddress {
  id         Int      @id @default(autoincrement())
  supplierId Int      @map("supplier_id")
  label      String   @default("Principal")
  zip        String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  primary    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, primary])
  @@map("supplier_addresses")
}

model SupplierTag {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  color     String            @default("#168151")
  createdAt DateTime          @default(now()) @map("created_at")
  links     SupplierTagLink[]

  @@map("supplier_tags")
}

model SupplierTagLink {
  supplierId Int         @map("supplier_id")
  tagId      Int         @map("tag_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tag        SupplierTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([supplierId, tagId])
  @@index([tagId, supplierId])
  @@map("supplier_tag_links")
}

model SupplierInteraction {
  id          Int       @id @default(autoincrement())
  supplierId  Int       @map("supplier_id")
  type        String
  subject     String
  notes       String?
  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, createdAt])
  @@index([supplierId, completedAt, dueAt])
  @@map("supplier_interactions")
}

model SupplierDocument {
  id            Int       @id @default(autoincrement())
  supplierId    Int       @map("supplier_id")
  type          String
  name          String
  number        String?
  status        String    @default("valid")
  issuedAt      DateTime? @map("issued_at") @db.Date
  expiresAt     DateTime? @map("expires_at") @db.Date
  fileReference String?   @map("file_reference")
  notes         String?
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, status, expiresAt])
  @@index([expiresAt, status])
  @@map("supplier_documents")
}

model SupplierEvaluation {
  id              Int      @id @default(autoincrement())
  supplierId      Int      @map("supplier_id")
  qualityScore    Int      @map("quality_score")
  deliveryScore   Int      @map("delivery_score")
  commercialScore Int      @map("commercial_score")
  complianceScore Int      @map("compliance_score")
  notes           String?
  evaluatedBy     String   @map("evaluated_by")
  evaluatedAt     DateTime @default(now()) @map("evaluated_at")
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, evaluatedAt])
  @@map("supplier_evaluations")
}

model SupplierProduct {
  id           Int      @id @default(autoincrement())
  supplierId   Int      @map("supplier_id")
  productId    Int      @map("product_id")
  supplierCode String?  @map("supplier_code")
  lastCost     Float?   @map("last_cost")
  leadTimeDays Int?     @map("lead_time_days")
  minimumOrder Float?   @map("minimum_order")
  preferred    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId, preferred])
  @@map("supplier_products")
}

model PurchaseQuotation {
  id              Int                      @id @default(autoincrement())
  number          String                   @unique
  title           String
  status          String                   @default("open")
  deadlineAt      DateTime?                @map("deadline_at") @db.Date
  notes           String?
  createdBy       String                   @map("created_by")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  purchaseOrderId Int?                     @unique @map("purchase_order_id")
  items           PurchaseQuotationItem[]
  offers          PurchaseQuotationOffer[]
  purchaseOrder   PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([status, deadlineAt])
  @@map("purchase_quotations")
}

model PurchaseQuotationItem {
  id          Int                          @id @default(autoincrement())
  quotationId Int                          @map("quotation_id")
  productId   Int                          @map("product_id")
  quantity    Float
  quotation   PurchaseQuotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  offerItems  PurchaseQuotationOfferItem[]

  @@unique([quotationId, productId])
  @@index([productId])
  @@map("purchase_quotation_items")
}

model PurchaseQuotationOffer {
  id           Int                          @id @default(autoincrement())
  quotationId  Int                          @map("quotation_id")
  supplierId   Int                          @map("supplier_id")
  subtotal     Float                        @default(0)
  freight      Float                        @default(0)
  discount     Float                        @default(0)
  total        Float
  leadTimeDays Int                          @default(0) @map("lead_time_days")
  paymentTerms String?                      @map("payment_terms")
  notes        String?
  selected     Boolean                      @default(false)
  createdAt    DateTime                     @default(now()) @map("created_at")
  quotation    PurchaseQuotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplier     Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items        PurchaseQuotationOfferItem[]

  @@unique([quotationId, supplierId])
  @@index([quotationId, total])
  @@map("purchase_quotation_offers")
}

model PurchaseQuotationOfferItem {
  id              Int                    @id @default(autoincrement())
  offerId         Int                    @map("offer_id")
  quotationItemId Int                    @map("quotation_item_id")
  unitCost        Float                  @map("unit_cost")
  total           Float
  offer           PurchaseQuotationOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  quotationItem   PurchaseQuotationItem  @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  @@unique([offerId, quotationItemId])
  @@index([quotationItemId])
  @@map("purchase_quotation_offer_items")
}

model PurchaseOrder {
  id                     Int                     @id @default(autoincrement())
  number                 String                  @unique
  supplierId             Int                     @map("supplier_id")
  status                 String                  @default("draft")
  expectedAt             DateTime?               @map("expected_at") @db.Date
  dueAt                  DateTime?               @map("due_at") @db.Date
  subtotal               Float                   @default(0)
  freight                Float                   @default(0)
  discount               Float                   @default(0)
  total                  Float                   @default(0)
  notes                  String?
  createdBy              String                  @map("created_by")
  orderedAt              DateTime?               @map("ordered_at")
  completedAt            DateTime?               @map("completed_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  supplier               Supplier                @relation(fields: [supplierId], references: [id])
  items                  PurchaseOrderItem[]
  receipts               GoodsReceipt[]
  quotation              PurchaseQuotation?
  productionProcurements ProductionProcurement[]

  @@index([status, expectedAt])
  @@index([supplierId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int                @id @default(autoincrement())
  purchaseOrderId  Int                @map("purchase_order_id")
  productId        Int                @map("product_id")
  variationId      Int?               @map("variation_id")
  quantity         Float
  receivedQuantity Float              @default(0) @map("received_quantity")
  unitCost         Float              @map("unit_cost")
  total            Float
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id])
  variation        ProductVariation?  @relation(fields: [variationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  receiptItems     GoodsReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              Int                @id @default(autoincrement())
  number          String             @unique
  purchaseOrderId Int                @map("purchase_order_id")
  receivedBy      String             @map("received_by")
  notes           String?
  warehouseId     Int?               @map("warehouse_id")
  idempotencyKey  String?            @unique @map("idempotency_key") @db.Uuid
  requestHash     String?            @map("request_hash")
  receivedAt      DateTime           @default(now()) @map("received_at")
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  items           GoodsReceiptItem[]
  warehouse       Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([purchaseOrderId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  Int               @id @default(autoincrement())
  goodsReceiptId      Int               @map("goods_receipt_id")
  purchaseOrderItemId Int               @map("purchase_order_item_id")
  productId           Int               @map("product_id")
  variationId         Int?              @map("variation_id")
  tracking            Json              @default("[]")
  quantity            Float
  unitCost            Float             @map("unit_cost")
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  product             Product           @relation(fields: [productId], references: [id])
  variation           ProductVariation? @relation(fields: [variationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([productId])
  @@map("goods_receipt_items")
}

model FinancialTitle {
  id                        Int                            @id @default(autoincrement())
  type                      String
  description               String
  supplierId                Int?                           @map("supplier_id")
  customerId                Int?                           @map("customer_id")
  branchId                  Int?                           @map("branch_id")
  accountId                 Int?                           @map("account_id")
  costCenterId              Int?                           @map("cost_center_id")
  documentNumber            String?                        @map("document_number")
  sourceType                String                         @map("source_type")
  sourceId                  String                         @map("source_id")
  amount                    Float
  paidAmount                Float                          @default(0) @map("paid_amount")
  issueAt                   DateTime                       @default(now()) @map("issue_at") @db.Date
  competenceAt              DateTime?                      @map("competence_at") @db.Date
  dueAt                     DateTime                       @map("due_at") @db.Date
  status                    String                         @default("open")
  category                  String?
  paymentMethod             String?                        @map("payment_method")
  barcode                   String?
  priority                  String                         @default("normal")
  recurrenceKey             String?                        @map("recurrence_key")
  installmentNumber         Int?                           @map("installment_number")
  installmentCount          Int?                           @map("installment_count")
  paidAt                    DateTime?                      @map("paid_at")
  notes                     String?
  createdAt                 DateTime                       @default(now()) @map("created_at")
  updatedAt                 DateTime                       @updatedAt @map("updated_at")
  supplier                  Supplier?                      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  customer                  Customer?                      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  branch                    Branch?                        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  account                   FinancialAccount?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  costCenter                CostCenter?                    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  settlements               FinancialSettlement[]
  bankTransactions          BankTransaction[]
  reconciliationAllocations BankReconciliationAllocation[]

  @@unique([sourceType, sourceId])
  @@index([type, status, dueAt])
  @@index([supplierId])
  @@index([customerId])
  @@index([branchId, type, status, dueAt])
  @@index([accountId, dueAt])
  @@index([costCenterId, dueAt])
  @@index([recurrenceKey, installmentNumber])
  @@map("financial_titles")
}

model FinancialAccount {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique @default(dbgenerated("('ACC-'::text || upper(substr(md5((random())::text), 1, 10)))"))
  name                String
  type                String
  currency            String                @default("BRL")
  branchId            Int?                  @map("branch_id")
  description         String?
  institutionName     String?               @map("institution_name")
  bankCode            String?               @map("bank_code")
  agency              String?
  accountNumberLast4  String?               @map("account_number_last4")
  color               String                @default("#168151")
  openingBalance      Float                 @default(0) @map("opening_balance")
  currentBalance      Float                 @default(0) @map("current_balance")
  creditLimit         Float                 @default(0) @map("credit_limit")
  openingBalanceCents Int                   @default(0) @map("opening_balance_cents")
  currentBalanceCents Int                   @default(0) @map("current_balance_cents")
  creditLimitCents    Int                   @default(0) @map("credit_limit_cents")
  version             Int                   @default(1)
  active              Boolean               @default(true)
  archivedAt          DateTime?             @map("archived_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  branch              Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  entries             AccountEntry[]
  transfersFrom       AccountTransfer[]     @relation("AccountTransferSource")
  transfersTo         AccountTransfer[]     @relation("AccountTransferDestination")
  bankImports         BankStatementImport[]
  bankTransactions    BankTransaction[]
  plannedTitles       FinancialTitle[]
  settlements         FinancialSettlement[]

  @@index([active, type])
  @@index([branchId, active])
  @@map("financial_accounts")
}

model AccountEntry {
  id                Int              @id @default(autoincrement())
  accountId         Int              @map("account_id")
  type              String
  amount            Float
  amountCents       Int              @default(0) @map("amount_cents")
  balanceAfterCents Int              @default(0) @map("balance_after_cents")
  description       String
  reference         String?
  sourceType        String           @map("source_type")
  sourceId          String           @map("source_id")
  correlationId     String?          @map("correlation_id")
  reversalOfId      Int?             @unique @map("reversal_of_id")
  occurredAt        DateTime         @default(now()) @map("occurred_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  createdBy         String           @map("created_by")
  account           FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reversalOf        AccountEntry?    @relation("AccountEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy        AccountEntry?    @relation("AccountEntryReversal")

  @@unique([sourceType, sourceId, accountId])
  @@index([accountId, occurredAt])
  @@index([correlationId])
  @@map("account_entries")
}

model AccountTransfer {
  id                     Int              @id @default(autoincrement())
  fromAccountId          Int              @map("from_account_id")
  toAccountId            Int              @map("to_account_id")
  amount                 Float
  amountCents            Int              @default(0) @map("amount_cents")
  description            String?
  status                 String           @default("posted")
  idempotencyKey         String?          @unique @map("idempotency_key")
  correlationId          String?          @map("correlation_id")
  reversalIdempotencyKey String?          @unique @map("reversal_idempotency_key")
  reversedAt             DateTime?        @map("reversed_at")
  reversedBy             String?          @map("reversed_by")
  reversalReason         String?          @map("reversal_reason")
  transferredBy          String           @map("transferred_by")
  createdAt              DateTime         @default(now()) @map("created_at")
  fromAccount            FinancialAccount @relation("AccountTransferSource", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount              FinancialAccount @relation("AccountTransferDestination", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([correlationId])
  @@map("account_transfers")
}

model PosAccountingAccount {
  id             String                       @id @default(cuid())
  code           String                       @unique
  name           String
  accountType    String                       @map("account_type")
  normalBalance  String                       @map("normal_balance")
  status         String                       @default("draft")
  externalCode   String?                      @map("external_code")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")
  policyMappings PosAccountingPolicyMapping[]
  postings       PosAccountingPosting[]

  @@index([status, accountType, code])
  @@map("pos_accounting_accounts")
}

model PosAccountingPeriod {
  id          String                 @id
  branchId    Int                    @map("branch_id")
  year        Int
  month       Int
  startsAt    DateTime               @map("starts_at") @db.Date
  endsAt      DateTime               @map("ends_at") @db.Date
  status      String                 @default("open")
  currency    String                 @default("BRL")
  revision    Int                    @default(1)
  configHash  String                 @default(dbgenerated()) @map("config_hash")
  closedAt    DateTime?              @map("closed_at")
  closedBy    String?                @map("closed_by")
  closeReason String?                @map("close_reason")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  branch      Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  journals    PosAccountingJournal[]

  @@unique([id, branchId], map: "pos_accounting_periods_id_branch_key")
  @@unique([branchId, year, month])
  @@index([status, startsAt, endsAt])
  @@map("pos_accounting_periods")
}

model PosAccountingPolicy {
  id                         String                         @id
  branchId                   Int                            @map("branch_id")
  version                    Int
  status                     String                         @default("draft")
  currency                   String                         @default("BRL")
  effectiveFrom              DateTime                       @map("effective_from") @db.Date
  effectiveUntil             DateTime?                      @map("effective_until") @db.Date
  mappingHash                String                         @map("mapping_hash")
  accountantApprovalRef      String?                        @map("accountant_approval_ref")
  homologatedBy              String?                        @map("homologated_by")
  homologatedAt              DateTime?                      @map("homologated_at")
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")
  branch                     Branch                         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  mappings                   PosAccountingPolicyMapping[]
  journals                   PosAccountingJournal[]
  manualFinalizationProfiles PosManualFinalizationProfile[]

  @@unique([id, branchId], map: "pos_accounting_policies_id_branch_key")
  @@unique([id, branchId, version], map: "pos_accounting_policies_id_branch_version_key")
  @@unique([id, branchId, version, mappingHash], map: "pos_accounting_policies_t2_identity_key")
  @@unique([branchId, version])
  @@index([branchId, status, effectiveFrom, effectiveUntil])
  @@map("pos_accounting_policies")
}

model PosAccountingPolicyMapping {
  id          String                 @id
  policyId    String                 @map("policy_id")
  sourceType  String                 @map("source_type")
  entryKey    String                 @map("entry_key")
  accountId   String                 @map("account_id")
  direction   String
  configHash  String                 @default(dbgenerated()) @map("config_hash")
  description String?
  createdAt   DateTime               @default(now()) @map("created_at")
  policy      PosAccountingPolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)
  account     PosAccountingAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  postings    PosAccountingPosting[]

  @@unique([id, accountId], map: "pos_accounting_policy_mappings_id_account_key")
  @@unique([policyId, sourceType, entryKey])
  @@index([accountId])
  @@map("pos_accounting_policy_mappings")
}

model PosAccountingJournal {
  id                 String                     @id
  branchId           Int                        @map("branch_id")
  costCenterId       Int                        @map("cost_center_id")
  periodId           String                     @map("period_id")
  policyId           String                     @map("policy_id")
  policyHash         String                     @map("policy_hash")
  originType         String                     @map("origin_type")
  originId           String                     @map("origin_id")
  originVersion      Int                        @map("origin_version")
  competenceDate     DateTime                   @map("competence_date") @db.Date
  occurredAt         DateTime                   @map("occurred_at")
  postedAt           DateTime                   @default(now()) @map("posted_at")
  currency           String                     @default("BRL")
  description        String
  sourceSnapshot     Json                       @map("source_snapshot")
  sourceSnapshotHash String                     @map("source_snapshot_hash")
  totalDebitCents    BigInt                     @map("total_debit_cents")
  totalCreditCents   BigInt                     @map("total_credit_cents")
  idempotencyKey     String                     @unique @map("idempotency_key")
  requestHash        String                     @map("request_hash")
  reversalOfId       String?                    @unique @map("reversal_of_id")
  reversalReason     String?                    @map("reversal_reason")
  createdBy          String                     @map("created_by")
  creationTxid       BigInt                     @default(dbgenerated("txid_current()")) @map("creation_txid")
  createdAt          DateTime                   @default(now()) @map("created_at")
  branch             Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  costCenter         CostCenter                 @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  period             PosAccountingPeriod        @relation(fields: [periodId, branchId], references: [id, branchId], onDelete: Restrict)
  policy             PosAccountingPolicy        @relation(fields: [policyId, branchId], references: [id, branchId], onDelete: Restrict)
  reversalOf         PosAccountingJournal?      @relation("PosAccountingJournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           PosAccountingJournal?      @relation("PosAccountingJournalReversal")
  postings           PosAccountingPosting[]
  exportOutbox       PosAccountingExportOutbox?

  @@unique([originType, originId, originVersion], map: "pos_accounting_journals_origin_key")
  @@index([branchId, competenceDate, id])
  @@index([costCenterId, competenceDate, id])
  @@index([periodId, id])
  @@index([policyId, id])
  @@map("pos_accounting_journals")
}

model PosAccountingPosting {
  id                  BigInt                     @id @default(autoincrement())
  journalId           String                     @map("journal_id")
  sequence            Int
  policyMappingId     String                     @map("policy_mapping_id")
  accountId           String                     @map("account_id")
  accountCodeSnapshot String                     @map("account_code_snapshot")
  accountNameSnapshot String                     @map("account_name_snapshot")
  direction           String
  amountCents         BigInt                     @map("amount_cents")
  amount              Decimal                    @db.Decimal(20, 2)
  description         String?
  dimensions          Json?
  creationTxid        BigInt                     @default(dbgenerated("txid_current()")) @map("creation_txid")
