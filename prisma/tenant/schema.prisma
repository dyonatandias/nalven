model IntegrationAiUsage {
  id           String   @id @default(cuid())
  requestId    String?  @map("request_id")
  feature      String
  model        String
  units        Int      @default(1)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  latencyMs    Int      @default(0) @map("latency_ms")
  keySource    String   @default("platform") @map("key_source")
  status       String   @default("completed")
  cost         Float    @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt, feature])
  @@index([createdAt, status])
  @@index([createdAt, model])
  @@index([createdAt, keySource])
  @@index([requestId])
  @@map("integration_ai_usage")
}

model IntegrationMediaMigration {
  id         String    @id @default(cuid())
  status     String    @default("pending")
  total      Int       @default(0)
  processed  Int       @default(0)
  failed     Int       @default(0)
  cursor     String?
  details    Json
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("integration_media_migrations")
}

model IntegrationInboundEvent {
  id          String    @id @default(cuid())
  eventId     String    @map("event_id")
  providerId  String    @map("provider_id")
  topic       String
  payload     Json
  status      String    @default("pending")
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  error       String?

  @@unique([providerId, eventId])
  @@index([providerId, status, receivedAt])
  @@map("integration_inbound_events")
}

model IntegrationOtpChallenge {
  id              String    @id @default(cuid())
  context         String
  recipientHash   String    @map("recipient_hash")
  recipientMasked String    @map("recipient_masked")
  ipHash          String    @map("ip_hash")
  codeHash        String    @map("code_hash")
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5) @map("max_attempts")
  fraudScore      Int       @default(0) @map("fraud_score")
  expiresAt       DateTime  @map("expires_at")
  verifiedAt      DateTime? @map("verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([recipientHash, context, createdAt])
  @@index([ipHash, context, createdAt])
  @@index([expiresAt])
  @@map("integration_otp_challenges")
}

model IntegrationRateLimit {
  id          String   @id
  count       Int      @default(0)
  windowStart DateTime @map("window_start")
  expiresAt   DateTime @map("expires_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("integration_rate_limits")
}

model PosLgpdRetentionPolicy {
  id               String                   @id
  version          Int                      @unique
  status           String                   @default("draft")
  policyHash       String                   @map("policy_hash")
  effectiveFrom    DateTime                 @map("effective_from")
  effectiveUntil   DateTime?                @map("effective_until")
  legalApprovalRef String?                  @map("legal_approval_ref")
  proposedBy       String                   @map("proposed_by")
  homologatedBy    String?                  @map("homologated_by")
  homologatedAt    DateTime?                @map("homologated_at")
  stepUpProofHash  String?                  @map("step_up_proof_hash")
  retiredBy        String?                  @map("retired_by")
  retiredAt        DateTime?                @map("retired_at")
  retirementReason String?                  @map("retirement_reason")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  inventoryObjects PosLgpdInventoryObject[]
  executionJobs    PosLgpdExecutionJob[]

  @@index([status, effectiveFrom, effectiveUntil])
  @@map("pos_lgpd_retention_policies")
}

model PosLgpdSubjectRequest {
  id                 String                      @id
  idempotencyKeyHash String                      @unique @map("idempotency_key_hash")
  subjectTokenHash   String                      @map("subject_token_hash")
  contactTokenHash   String?                     @map("contact_token_hash")
  tokenKeyId         String                      @map("token_key_id")
  tokenVersion       Int                         @default(1) @map("token_version")
  requestType        String                      @map("request_type")
  state              String                      @default("received")
  scopeHash          String                      @map("scope_hash")
  dueAt              DateTime                    @map("due_at")
  version            Int                         @default(1)
  decisionProposedBy String?                     @map("decision_proposed_by")
  decisionApprovedBy String?                     @map("decision_approved_by")
  decisionReasonCode String?                     @map("decision_reason_code")
  decisionStepUpHash String?                     @map("decision_step_up_hash")
  verifiedAt         DateTime?                   @map("verified_at")
  decidedAt          DateTime?                   @map("decided_at")
  completedAt        DateTime?                   @map("completed_at")
  createdBy          String                      @map("created_by")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  stateLedger        PosLgpdRequestStateLedger[]
  executionJobs      PosLgpdExecutionJob[]

  @@index([state, dueAt, createdAt])
  @@index([subjectTokenHash, createdAt])
  @@map("pos_lgpd_subject_requests")
}

model PosLgpdRequestStateLedger {
  id            BigInt                @id @default(autoincrement())
  requestId     String                @map("request_id")
  sequence      Int
  fromState     String?               @map("from_state")
  toState       String                @map("to_state")
  actorId       String                @map("actor_id")
  reasonCode    String                @map("reason_code")
  correlationId String                @map("correlation_id")
  priorHash     String?               @map("prior_hash")
  eventHash     String                @unique @map("event_hash")
  creationTxid  BigInt                @default(dbgenerated("txid_current()")) @map("creation_txid")
  occurredAt    DateTime              @default(now()) @map("occurred_at")
  request       PosLgpdSubjectRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requestId, sequence])
  @@index([requestId, occurredAt])
  @@map("pos_lgpd_request_state_ledger")
}

model PosLgpdInventoryObject {
  id                String                  @id
  objectType        String                  @map("object_type")
  objectKeyHash     String                  @map("object_key_hash")
  subjectTokenHash  String                  @map("subject_token_hash")
  tokenKeyId        String                  @map("token_key_id")
  tokenVersion      Int                     @default(1) @map("token_version")
  dataCategory      String                  @map("data_category")
  sourceVersion     Int                     @map("source_version")
  manifestHash      String                  @map("manifest_hash")
  state             String                  @default("observed")
  retentionPolicyId String?                 @map("retention_policy_id")
  discoveredAt      DateTime                @map("discovered_at")
  lastObservedAt    DateTime                @map("last_observed_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  retentionPolicy   PosLgpdRetentionPolicy? @relation(fields: [retentionPolicyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  executionJobs     PosLgpdExecutionJob[]

  @@unique([objectType, objectKeyHash])
  @@index([subjectTokenHash, dataCategory, state])
  @@index([retentionPolicyId, state])
  @@map("pos_lgpd_inventory_objects")
}

model PosLgpdLegalHold {
  id                 String    @id
  idempotencyKeyHash String    @unique @map("idempotency_key_hash")
  subjectTokenHash   String    @map("subject_token_hash")
  tokenKeyId         String    @map("token_key_id")
  tokenVersion       Int       @default(1) @map("token_version")
  objectType         String?   @map("object_type")
  objectKeyHash      String?   @map("object_key_hash")
  dataCategory       String?   @map("data_category")
  state              String    @default("active")
  reasonCode         String    @map("reason_code")
  legalReferenceHash String    @map("legal_reference_hash")
  proposedBy         String    @map("proposed_by")
  approvedBy         String    @map("approved_by")
  stepUpProofHash    String    @map("step_up_proof_hash")
  startsAt           DateTime  @map("starts_at")
  expiresAt          DateTime? @map("expires_at")
  releaseProposedBy  String?   @map("release_proposed_by")
  releasedBy         String?   @map("released_by")
  releaseStepUpHash  String?   @map("release_step_up_hash")
  releaseReasonCode  String?   @map("release_reason_code")
  releasedAt         DateTime? @map("released_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([subjectTokenHash, state, startsAt, expiresAt])
  @@index([objectType, objectKeyHash, state])
  @@index([dataCategory, state])
  @@map("pos_lgpd_legal_holds")
}

model PosLgpdExecutionJob {
  id                 String                  @id
  requestId          String                  @map("request_id")
  inventoryObjectId  String?                 @map("inventory_object_id")
  retentionPolicyId  String?                 @map("retention_policy_id")
  action             String
  state              String                  @default("blocked")
  blockReason        String?                 @map("block_reason")
  idempotencyKeyHash String                  @unique @map("idempotency_key_hash")
  tokenKeyId         String                  @map("token_key_id")
  tokenVersion       Int                     @default(1) @map("token_version")
  requestHash        String                  @map("request_hash")
  policyHash         String?                 @map("policy_hash")
  adapterId          String?                 @map("adapter_id")
  attemptCount       Int                     @default(0) @map("attempt_count")
  maxAttempts        Int                     @default(8) @map("max_attempts")
  claimTokenHash     String?                 @map("claim_token_hash")
  claimExpiresAt     DateTime?               @map("claim_expires_at")
  resultHash         String?                 @map("result_hash")
  matchedCount       BigInt                  @default(0) @map("matched_count")
  processedCount     BigInt                  @default(0) @map("processed_count")
  failedCount        BigInt                  @default(0) @map("failed_count")
  completedAt        DateTime?               @map("completed_at")
  createdBy          String                  @map("created_by")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  request            PosLgpdSubjectRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inventoryObject    PosLgpdInventoryObject? @relation(fields: [inventoryObjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  retentionPolicy    PosLgpdRetentionPolicy? @relation(fields: [retentionPolicyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  outbox             PosLgpdExecutionOutbox?

  @@unique([requestId, action, inventoryObjectId])
  @@index([state, createdAt])
  @@index([claimExpiresAt])
  @@map("pos_lgpd_execution_jobs")
}

model PosLgpdExecutionOutbox {
  id             BigInt              @id @default(autoincrement())
  jobId          String              @unique @map("job_id")
  state          String              @default("blocked")
  payloadHash    String              @map("payload_hash")
  deliveryCount  Int                 @default(0) @map("delivery_count")
  nextAttemptAt  DateTime?           @map("next_attempt_at")
  claimTokenHash String?             @map("claim_token_hash")
  claimExpiresAt DateTime?           @map("claim_expires_at")
  lastErrorCode  String?             @map("last_error_code")
  resultHash     String?             @map("result_hash")
  completedAt    DateTime?           @map("completed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  job            PosLgpdExecutionJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([state, nextAttemptAt])
  @@index([claimExpiresAt])
  @@map("pos_lgpd_execution_outbox")
}

model PosLgpdEvidence {
  id                BigInt   @id @default(autoincrement())
  aggregateType     String   @map("aggregate_type")
  aggregateId       String   @map("aggregate_id")
  evidenceType      String   @map("evidence_type")
  schemaVersion     Int      @default(1) @map("schema_version")
  manifestHash      String   @map("manifest_hash")
  priorEvidenceHash String?  @map("prior_evidence_hash")
  evidenceHash      String   @unique @map("evidence_hash")
  matchedCount      BigInt   @default(0) @map("matched_count")
  plannedCount      BigInt   @default(0) @map("planned_count")
  processedCount    BigInt   @default(0) @map("processed_count")
  failedCount       BigInt   @default(0) @map("failed_count")
  actorId           String   @map("actor_id")
  correlationId     String   @map("correlation_id")
  creationTxid      BigInt   @default(dbgenerated("txid_current()")) @map("creation_txid")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([aggregateType, aggregateId, id])
  @@map("pos_lgpd_evidence")
}
