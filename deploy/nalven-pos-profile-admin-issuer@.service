[Unit]
Description=NALVEN manual profile admin assertion issuer for tenant %i
After=network-online.target postgresql.service
Wants=network-online.target
ConditionFileIsExecutable=/usr/local/bin/nalven-pos-profile-admin-issuer

[Service]
Type=simple
User=nalven-pos-profile-admin
Group=nalven-pos-profile-admin
EnvironmentFile=/etc/nalven/tenant-manual-profile-admin-issuers/%i.env
Environment=TZ=America/Sao_Paulo
ExecStart=/usr/local/bin/nalven-pos-profile-admin-issuer --tenant %i
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
InaccessiblePaths=/etc/nalven/tenants /etc/nalven/tenant-migrators /etc/nalven/tenant-manual-workers /etc/nalven/tenant-manual-callbacks /etc/nalven/tenant-stepup-issuers /etc/nalven/tenant-manual-homologators /etc/nalven/tenant-manual-vault-binders /etc/nalven/tenant-manual-profile-accounting-issuers /etc/nalven/tenant-manual-profile-fiscal-issuers /etc/nalven/tenant-manual-sweepers
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
